{
  "info": {
    "_postman_id": "8cf8d69e-c7a7-4f88-a9e4-bc9dfe52b780",
    "name": "TripNest Auth Service - No Email OTP",
    "description": "Service 1 backend checks for registration, login, JWT, current user and admin company approval.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "    pm.collectionVariables.set('runId', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "companyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Service is UP', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('UP');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Register Tourist",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"tourist_{{runId}}\",\n  \"password\": \"Tourist@123\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tourist\",\n  \"email\": \"tourist.{{runId}}@tripnest.test\",\n  \"phone\": null,\n  \"address\": \"Pune\",\n  \"role\": \"TOURIST\",\n  \"companyName\": null,\n  \"registrationNumber\": null,\n  \"companyAddress\": null\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Tourist registration returns 201', () => pm.response.to.have.status(201));",
              "pm.test('Tourist is active', () => pm.expect(pm.response.json().userStatus).to.eql('ACTIVE'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Duplicate Tourist Registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"tourist_duplicate_{{runId}}\",\n  \"password\": \"Tourist@123\",\n  \"firstName\": \"Duplicate\",\n  \"lastName\": \"Tourist\",\n  \"email\": \"tourist.{{runId}}@tripnest.test\",\n  \"role\": \"TOURIST\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Duplicate email returns 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Login Tourist",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"tourist_{{runId}}\",\n  \"password\": \"Tourist@123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Tourist login returns JWT', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Current User Without JWT",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Anonymous request returns 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin@tripnest.demo\",\n  \"password\": \"Admin@123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin login returns JWT', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('token', body.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - Current User With JWT",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('JWT request returns current user', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "8 - Register Company",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"company_{{runId}}\",\n  \"password\": \"Company@123\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Company\",\n  \"email\": \"company.{{runId}}@tripnest.test\",\n  \"phone\": null,\n  \"address\": \"Mumbai\",\n  \"role\": \"COMPANY\",\n  \"companyName\": \"Postman Travels {{runId}}\",\n  \"registrationNumber\": \"POSTMAN-{{runId}}\",\n  \"companyAddress\": \"Mumbai\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Company registration is pending', () => {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().companyStatus).to.eql('PENDING');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9 - Company Login Before Approval",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"company_{{runId}}\",\n  \"password\": \"Company@123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Pending company login returns 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - List Pending Companies",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/companies/pending"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin can list pending companies', () => pm.response.to.have.status(200));",
              "const company = pm.response.json().find(item => item.registrationNumber === `POSTMAN-${pm.collectionVariables.get('runId')}`);",
              "pm.expect(company, 'New company is present').to.exist;",
              "pm.collectionVariables.set('companyId', company.companyId);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Approve Company",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/companies/{{companyId}}/approve"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin approves company', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('APPROVED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Company Login After Approval",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"company_{{runId}}\",\n  \"password\": \"Company@123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Approved company receives JWT', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
